<?php

use PHPUnit\Framework\TestCase;
use UpSun\Sdk\Core\Tasks\OrganizationTask;
use UpSun\Sdk\Http\Client\ApiClient;

class OrganizationTaskTest extends TestCase
{
    private OrganizationTask $task;
    private ApiClient $apiClient;

    protected function setUp(): void
    {
        $this->apiClient = $this->createMock(ApiClient::class);
        $this->task = new OrganizationTask($this->apiClient);
    }

    public function testCreate(): void
    {
        $params = ['name' => 'Acme Inc.'];
        $expected = ['id' => 'org_123'];

        $this->apiClient->method('post')->willReturn($expected);

        $result = $this->task->create($params);
        $this->assertEquals($expected, $result);
    }

    public function testUpdate(): void
    {
        $orgId = 'org_123';
        $params = ['name' => 'Acme Updated'];
        $expected = ['id' => $orgId, 'name' => 'Acme Updated'];

        $this->apiClient->method('patch')->willReturn($expected);

        $result = $this->task->update($orgId, $params);
        $this->assertEquals($expected, $result);
    }

    public function testDelete(): void
    {
        $orgId = 'org_123';

        $this->apiClient->expects($this->once())
            ->method('delete')
            ->with("organizations/$orgId");

        $this->task->delete($orgId);
    }

    public function testGet(): void
    {
        $orgId = 'org_123';
        $expected = ['id' => $orgId];

        $this->apiClient->method('get')->willReturn($expected);

        $result = $this->task->get($orgId);
        $this->assertEquals($expected, $result);
    }

    public function testList(): void
    {
        $expected = [['id' => 'org_1'], ['id' => 'org_2']];
        $this->apiClient->method('get')->willReturn($expected);

        $result = $this->task->list();
        $this->assertEquals($expected, $result);
    }

    public function testListMembers(): void
    {
        $orgId = 'org_123';
        $expected = [['user_id' => 'user_1'], ['user_id' => 'user_2']];
        $this->apiClient->method('get')->willReturn($expected);

        $result = $this->task->listMembers($orgId);
        $this->assertEquals($expected, $result);
    }

    public function testCreateMember(): void
    {
        $orgId = 'org_123';
        $params = ['user_id' => 'user_1'];
        $expected = ['user_id' => 'user_1'];

        $this->apiClient->method('post')->willReturn($expected);

        $result = $this->task->createMember($orgId, $params);
        $this->assertEquals($expected, $result);
    }

    public function testUpdateMember(): void
    {
        $orgId = 'org_123';
        $memberId = 'user_1';
        $params = ['role' => 'admin'];
        $expected = ['user_id' => $memberId, 'role' => 'admin'];

        $this->apiClient->method('patch')->willReturn($expected);

        $result = $this->task->updateMember($orgId, $memberId, $params);
        $this->assertEquals($expected, $result);
    }

    public function testDeleteMember(): void
    {
        $orgId = 'org_123';
        $memberId = 'user_1';

        $this->apiClient->expects($this->once())
            ->method('delete')
            ->with("organizations/$orgId/members/$memberId");

        $this->task->deleteMember($orgId, $memberId);
    }

    public function testEnableMfaEnforcement(): void
    {
        $orgId = 'org_123';
        $this->apiClient->expects($this->once())
            ->method('post')
            ->with("organizations/$orgId/mfa/enforce");

        $this->task->enableMfaEnforcement($orgId);
    }

    public function testDisableMfaEnforcement(): void
    {
        $orgId = 'org_123';
        $this->apiClient->expects($this->once())
            ->method('delete')
            ->with("organizations/$orgId/mfa/enforce");

        $this->task->disableMfaEnforcement($orgId);
    }

    public function testGetMfaEnforcement(): void
    {
        $orgId = 'org_123';
        $expected = ['enabled' => true];
        $this->apiClient->method('get')->willReturn($expected);

        $result = $this->task->getMfaEnforcement($orgId);
        $this->assertEquals($expected, $result);
    }

    
}
