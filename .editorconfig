; top-most EditorConfig file
root = true

; Unix-style newlines
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php}]
indent_style = space
indent_size = 4

[*.{json,xml,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 120
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[COMMIT_EDITMSG]
max_line_length = 0
