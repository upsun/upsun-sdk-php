{
    "name": "upsun/upsun-sdk-php",
    "license": "Apache-2.0",
    "description": "A PHP library serving as a facade for the Upsun.",
    "type": "library",
    "require": {
        "php": "^7.4 || ^8.0",
        "openapitools/openapi-generator-cli": "^6.3.0",
        "php-http/client-common": "^2.7",
        "php-http/discovery": "^1.20",
        "php-http/message": "^1.16",
        "guzzlehttp/psr7": "^2.7",
        "php-http/message-factory": "^1.1",
        "symfony/http-client": "^7",
        "php-http/httplug": "^2.4",
        "php-http/curl-client": "^2.3",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Upsun\\": "src/",
            "OpenAPI\\Client\\": "apisgen/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs --standard=PSR12 src/Core/Tasks",
        "fix": "phpcbf --standard=PSR12 src/Core/Tasks",
        "generate-sdk": "./scripts/generate.sh"
    },
    "post-install-cmd": ["@generate-sdk"],
    "post-update-cmd": ["@generate-sdk"],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "openapitools/openapi-generator-cli": true
        },
        "bin-dir": "vendor/bin"
    }
}
