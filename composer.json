{
    "name": "upsun/upsun-sdk-php",
    "description": "A PHP library serving as a facade for the Upsun.",
    "type": "library",
    "require": {
        "php": "^7.4 || ^8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Upsun\\": "src/",
            "OpenAPI\\Client\\": "apisgen/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs --standard=PSR12 src/Core/Tasks",
        "fix": "phpcbf --standard=PSR12 src/Core/Tasks || true"
    }
}