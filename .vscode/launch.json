{
  "configurations": [
  {
    "name": "Launch Test App",
    "type": "php",
    "request": "launch",
    "program": "${workspaceFolder}/src/app.php",
    "cwd": "${workspaceFolder}",
    "port": 0,
    "runtimeArgs": [
      "-dxdebug.start_with_request=yes"
    ],
    "env": {
      "XDEBUG_MODE": "debug,develop",
      "XDEBUG_CONFIG": "client_port=${port}"
    }
  }
  ]
}