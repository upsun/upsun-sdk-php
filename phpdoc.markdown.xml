<phpdocumentor
        configVersion="3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://www.phpdoc.org"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/phpDocumentor/phpDocumentor/master/data/xsd/phpdoc.xsd"
>
    <title>Upsun SDK PHP Documentation</title>
    <paths>
        <output>docs</output>
    </paths>
    <version number="3.0.0">
        <api>
            <source dsn=".">
                <path>src</path>
                <path>src/Core</path>
                <path>src/Core/Tasks</path>
                <path>src/Api</path>
                <path>src/Model</path>
            </source>
        </api>
    </version>

    <template name="./phpdoc/themes/markdown">
      <parameter name="urlFileExtensions" value="yes"/>
      <parameter name="includeTitle" value="yes"/>
    </template>

</phpdocumentor>
